# Base URL of the Vitarchy server. Empty = same origin (the Vite dev proxy forwards /api).
# A Tauri build sets this to http://127.0.0.1:3000.
VITE_API_BASE_URL=

# Port for the UI dev/preview server (127.0.0.1 only).
WEB_PORT=7420

# Port of the API the dev proxy forwards /api to, used only when BIND_ADDR is not set.
# `make dev` and `make stage` export BIND_ADDR from .env / .env.stage, which wins.
API_PORT=3000

# Browser console log level: debug | info | warn | error | silent.
# Default: debug in `vite dev`, warn in a production build. Console only; nothing is sent anywhere.
VITE_LOG_LEVEL=

# `make stage` sets WEB_PORT (and BIND_ADDR) from .env.stage.
