# Copy to .env
POSTGRES_PORT=5433
DATABASE_URL=postgres://vitarchy:vitarchy@127.0.0.1:5433/vitarchy
BIND_ADDR=127.0.0.1:3000
# Log level filter. Unset: info, with sqlx/hyper/h2/tower quieted to warn.
# e.g. RUST_LOG=debug, or RUST_LOG=vitarchy_settings=debug,info
# RUST_LOG=info
# Log output: pretty (default, human-readable) or json (one object per line).
LOG_FORMAT=pretty
