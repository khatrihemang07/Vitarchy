# LIVE environment. Copy to .env (`make setup` does this).
# The single source for the live Postgres port, user, password and database name:
# scripts/compose.sh passes them to docker-compose.yml, and scripts/lib/db-url.sh
# uses this URL to recognise (and refuse) the live database from stage tooling.
DATABASE_URL=postgres://vitarchy:vitarchy@127.0.0.1:5433/vitarchy
# API address for `make dev` (the Vite dev server proxies /api to this port).
BIND_ADDR=127.0.0.1:3000
# Address for `make start`, where the server serves the app AND the API (loopback only).
START_ADDR=127.0.0.1:7400
# Log level filter. Unset: info, with sqlx/hyper/h2/tower quieted to warn.
# e.g. RUST_LOG=debug, or RUST_LOG=vitarchy_settings=debug,info
# RUST_LOG=info
# Log output: pretty (default, human-readable) or json (one object per line).
LOG_FORMAT=pretty
# Leave WEB_DIST unset here: `make start` sets it (to web/dist) so the server also
# serves the built web app. Unset, the server is API-only (what `make dev` wants).
# WEB_DIST=
# Finance: the folder holding the original Statement files, named by SHA-256, and backed up
# by `make backup`. Unset: ~/Library/Application Support/Vitarchy/statements.
# FINANCE_STATEMENTS_DIR=
# Finance: the statement-reader helper. Optional; unset or empty, it defaults to the reader
# installed by `make setup` / `make finance-reader-install` (see scripts/with-env.sh).
# Set it only to use another one.
# FINANCE_READER=
