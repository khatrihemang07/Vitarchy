# STAGE environment: copied to .env.stage by `make setup` (gitignored).
# Used by `make stage`, `make test`, `make check` and `make smoke`. A separate,
# throwaway Postgres (RAM only) so nothing here can touch the live database.
# DATABASE_URL is the single source for the stage Postgres port and database name
# (scripts/compose.sh passes them to docker-compose.yml). It must not match .env.
DATABASE_URL=postgres://vitarchy:vitarchy@127.0.0.1:5434/vitarchy_stage
BIND_ADDR=127.0.0.1:3100
# UI port for the Vite dev server (web/vite.config.ts). It proxies /api to BIND_ADDR's port.
WEB_PORT=7520
RUST_LOG=info
LOG_FORMAT=pretty
# Finance: stage keeps Statement originals in a throwaway folder, never the real one.
# `make backup-stage` / `make restore-stage` archive and restore it with the SQL dump.
FINANCE_STATEMENTS_DIR=/tmp/vitarchy-stage-statements
# Finance: the statement-reader helper. Optional; unset or empty, it defaults to the reader
# installed by `make setup` / `make finance-reader-install`.
# FINANCE_READER=
